    "     \"end_time\": \"2026-10-19T08:20:10.759711Z\",\n",
    "     \"start_time\": \"2026-10-19T08:20:10.753906Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"# 7. 测试集最终评估与新数据预测：检查泛化能力，预测新房屋的目标价格\\n\",\n",
    "    \"pred_y = model.predict(test_X)\\n\",\n",
    "    \"print(f\\\"loss: {mean_absolute_error(test_y, pred_y)}\\\")\\n\",\n",
    "    \"# 列堆叠，将1-D数据拼接为2-D\\n\",\n",
    "    \"res = np.column_stack((test_y, pred_y, test_y - pred_y))\\n\",\n",
    "    \"print(res)\"\n",
    "   ],\n",
