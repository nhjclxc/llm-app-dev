    "    {\n",
    "     \"data\": {\n",
    "      \"text/plain\": [\n",
    "       \"(506,)\"\n",
    "      ]\n",
    "     },\n",
    "     \"metadata\": {},\n",
    "     \"output_type\": \"display_data\"\n",
    "    }\n",
    "   ],\n",
