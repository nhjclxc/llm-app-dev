    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-10-19T08:20:09.061074Z\",\n",
    "     \"start_time\": \"2026-10-19T08:20:09.051010Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"# 5. 训练线性回归模型：使用 sklearn 的 LinearRegression\\n\",\n",
    "    \"model = LinearRegression(fit_intercept=False)\\n\",\n",
    "    \"# X：二维数组，形状为 (样本数量, 特征数量)。\\n\",\n",
    "    \"# y：一维数组，形状为 (样本数量,)；也可以是二维数组 (样本数量, 目标数量)，用于多目标回归。\\n\",\n",
    "    \"model.fit(train_X, train_y)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 输出权重w和偏置b\\n\",\n",
    "    \"print(model.coef_)\\n\",\n",
    "    \"print(model.intercept_)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 使用 joblib 保存和加载训练好的模型\\n\",\n",
    "    \"import joblib\\n\",\n",
    "    \"joblib.dump(model, '../../../data/output/HousingData_linear_regression.pkl')\\n\"\n",
    "   ],\n",
    "   \"id\": \"e3c9bc8dc004f507\",\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"[-0.07733665  0.04631702 -0.02133505  3.91837734 -4.11316186  5.94877489\\n\",\n",
    "      \" -0.01786578 -0.99329848  0.14265914 -0.00706123 -0.3864806   0.01558265\\n\",\n",
    "      \" -0.37989345]\\n\",\n",
    "      \"0.0\\n\"\n",
    "     ]\n",
    "    },\n",
    "    {\n",
