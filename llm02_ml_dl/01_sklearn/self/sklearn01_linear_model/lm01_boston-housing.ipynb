    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"# 3. 划分特征 X 和目标 y：X 是房屋相关特征，y 是房价目标值\\n\",\n",
    "    \"# X = 所有用于预测的房屋特征列\\n\",\n",
    "    \"# y = 房屋价格目标列\\n\",\n",
    "    \"\\n\",\n",
    "    \"src_data = df.to_numpy()\\n\",\n",
    "    \"X = src_data[:, :-1]\\n\",\n",
    "    \"y = src_data[:, -1]\\n\",\n",
    "    \"display(X.shape, y.shape)\\n\"\n",
    "   ],\n",
