    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"\\n\",\n",
    "    \"# 2. 数据探索与清洗：检查列名、数据类型、缺失值、重复值和异常值\\n\",\n",
    "    \"# 丢弃无效数据的行\\n\",\n",
    "    \"# df = df.dropna()\\n\",\n",
    "    \"# df.fillna(0, inplace=True)\\n\",\n",
    "    \"df.fillna(df.mean(numeric_only=True), inplace=True)\\n\",\n",
    "    \"print(len(df))\"\n",
    "   ],\n",
