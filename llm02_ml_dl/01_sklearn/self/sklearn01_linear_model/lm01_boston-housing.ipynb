    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-10-19T08:20:10.083317Z\",\n",
    "     \"start_time\": \"2026-10-19T08:20:10.075076Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"# 6. 验证模型与评估效果：使用 MAE、RMSE、R² 等指标\\n\",\n",
    "    \"# sklearn.metrics 是 Scikit-learn 中专门用于评估机器学习模型性能的模块\\n\",\n",
    "    \"# 任务类型\\t常用指标\\t主要用途\\n\",\n",
    "    \"# 回归\\tmean_absolute_error\\t平均绝对误差，直观衡量平均偏差。越小越好，关注平均误差\\n\",\n",
    "    \"# 回归\\tmean_squared_error\\t均方误差，惩罚较大的预测误差。越小越好，关注平均误差\\n\",\n",
    "    \"# 回归\\troot_mean_squared_error\\t均方根误差，与目标值单位相同。越小越好，关注平均误差\\n\",\n",
    "    \"# 回归\\tr2_score\\t决定系数，衡量模型相对基线的拟合表现。通常越接近 1 越好，关注相对于均值基准的拟合效果\\n\",\n",
    "    \"from sklearn.metrics import (mean_absolute_error, mean_squared_error, root_mean_squared_error, r2_score)\\n\",\n",
    "    \"\\n\",\n",
    "    \"pred_y = model.predict(validation_X)\\n\",\n",
    "    \"print(f\\\"MAE: {mean_absolute_error(validation_y, pred_y)}\\\")\\n\",\n",
    "    \"print(f\\\"MSE: {mean_squared_error(validation_y, pred_y)}\\\")\\n\",\n",
    "    \"print(f\\\"RMSE: {root_mean_squared_error(validation_y, pred_y)}\\\")\\n\",\n",
    "    \"print(f\\\"R^2: {r2_score(validation_y, pred_y)}\\\")\\n\"\n",
    "   ],\n",
    "   \"id\": \"9a4e0559c630c802\",\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"MAE: 3.566540304856757\\n\",\n",
    "      \"MSE: 20.71162161404888\\n\",\n",
    "      \"RMSE: 4.551002264781779\\n\",\n",
    "      \"R^2: 0.7135871561117112\\n\"\n",
    "     ]\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 95\n",
