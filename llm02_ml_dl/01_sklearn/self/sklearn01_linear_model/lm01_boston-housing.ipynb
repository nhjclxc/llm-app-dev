    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"from sklearn.linear_model import LinearRegression\\n\",\n",
    "    \"# pipeline 包导入\\n\",\n",
    "    \"from sklearn.pipeline import Pipeline\\n\",\n",
    "    \"# 预处理包导入 StandardScaler 标准化特征\\n\",\n",
    "    \"from sklearn.preprocessing import StandardScaler\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 为什么需要 Pipeline？\\n\",\n",
    "    \"# 假设你训练一个线性回归模型，需要先标准化特征，再训练模型。\\n\",\n",
    "    \"\\\"\\\"\\\"\\n\",\n",
    "    \"Pipeline语法：\\n\",\n",
    "    \"\\n\",\n",
    "    \"Pipeline([\\n\",\n",
    "    \"    (\\\"步骤名称1\\\", 转换器1),\\n\",\n",
    "    \"    (\\\"步骤名称2\\\", 转换器2),\\n\",\n",
    "    \"    (\\\"最终模型名称\\\", 预测模型)\\n\",\n",
    "    \"])\\n\",\n",
    "    \"\\\"\\\"\\\"\"\n",
    "   ],\n",
    "   \"id\": \"6a38db1b3b15c67e\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 105\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-10-20T03:32:15.901588Z\",\n",
    "     \"start_time\": \"2026-10-20T03:32:15.896832Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"pipeline_model = Pipeline([\\n\",\n",
    "    \"    (\\\"scaler\\\", StandardScaler()),\\n\",\n",
    "    \"    (\\\"regressor\\\", LinearRegression(fit_intercept=True))\\n\",\n",
    "    \"])\\n\",\n",
    "    \"pipeline_model.fit(train_X, train_y)\\n\",\n",
    "    \"print(\\\"coef_: \\\", pipeline_model.named_steps[\\\"regressor\\\"].coef_)\\n\",\n",
    "    \"print(\\\"intercept_: \\\", pipeline_model.named_steps[\\\"regressor\\\"].intercept_)\\n\",\n",
    "    \"print(pipeline_model.named_steps[\\\"scaler\\\"].mean_)\"\n",
    "   ],\n",
