    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-10-19T08:19:28.308592Z\",\n",
    "     \"start_time\": \"2026-10-19T08:19:28.296546Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"# 4. 划分训练集、验证集和测试集：避免用测试集指导模型训练\\n\",\n",
    "    \"\\n\",\n",
    "    \"# train:tets:validation=8:1:1\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 使用 from sklearn.model_selection import train_test_split 来随机划分\\n\",\n",
    "    \"from sklearn.model_selection import train_test_split\\n\",\n",
    "    \"# train_test_split 每次只能划分出两个数据集。\\n\",\n",
    "    \"# 因此先划分出测试集，再从剩余数据中划分训练集和验证集，此外使用固定随机种子，确保实验可复现\\n\",\n",
    "    \"# train_test_split返回值是set1_X, set2_X, set1_y, set2_y\\n\",\n",
    "    \"train_X, tmp_X, train_y, tmp_y = train_test_split(X, y, test_size=0.2, random_state=23)\\n\",\n",
    "    \"validation_X, test_X, validation_y, test_y = train_test_split(tmp_X, tmp_y, test_size=0.5, random_state=23)\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(train_X.shape, train_y.shape, test_X.shape, test_y.shape, validation_X.shape, validation_y.shape)\\n\",\n",
    "    \"display(train_X[0], train_y[0])\\n\"\n",
    "   ],\n",
    "   \"id\": \"a20b3b06e11b0629\",\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"(404, 13) (404,) (51, 13) (51,) (51, 13) (51,)\\n\"\n",
    "     ]\n",
    "    },\n",
    "    {\n",
    "     \"data\": {\n",
    "      \"text/plain\": [\n",
    "       \"array([6.6640e-02, 0.0000e+00, 4.0500e+00, 0.0000e+00, 5.1000e-01,\\n\",\n",
    "       \"       6.5460e+00, 3.3100e+01, 3.1323e+00, 5.0000e+00, 2.9600e+02,\\n\",\n",
    "       \"       1.6600e+01, 3.9096e+02, 5.3300e+00])\"\n",
    "      ]\n",
    "     },\n",
    "     \"metadata\": {},\n",
    "     \"output_type\": \"display_data\"\n",
