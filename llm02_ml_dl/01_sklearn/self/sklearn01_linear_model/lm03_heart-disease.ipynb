    "   \"source\": [\n",
    "    \"# 心脏病预测 heart-disease\\n\",\n",
    "    \"# 特征信息\\n\",\n",
    "    \"# Age: 患者年龄 [岁]\\n\",\n",
    "    \"# Sex: 患者性别 [M: 男性, F: 女性]\\n\",\n",
    "    \"# ChestPainType: 胸痛类型 [TA: 典型心绞痛, ATA: 非典型心绞痛, NAP: 非心绞痛, ASY: 无症状]\\n\",\n",
    "    \"# RestingBP: 静息血压 [mm Hg]\\n\",\n",
    "    \"# Cholesterol: 血清胆固醇 [mm/dl]\\n\",\n",
    "    \"# FastingBS: 空腹血糖 [1: 如果空腹血糖 > 120 mg/dl, 0: 否则]\\n\",\n",
    "    \"# RestingECG: 静息心电图结果 [Normal: 正常, ST: ST-T波异常 (T波倒置和/或ST段抬高或降低 > 0.05 mV), LVH: 按照Estes标准显示可能或明确的左心室肥大]\\n\",\n",
    "    \"# MaxHR: 最大心率 [60 到 202 之间的数值]\\n\",\n",
    "    \"# ExerciseAngina: 运动诱发的心绞痛 [Y: 有, N: 无]\\n\",\n",
    "    \"# Oldpeak: Oldpeak = ST [测量的ST段抑制的数值]\\n\",\n",
    "    \"# ST_Slope: 峰值运动ST段的斜率 [Up: 上升, Flat: 平坦, Down: 下降]\\n\",\n",
    "    \"# HeartDisease: 输出类别 [1: 心脏病, 0: 正常]\\n\"\n",
    "   ],\n",
