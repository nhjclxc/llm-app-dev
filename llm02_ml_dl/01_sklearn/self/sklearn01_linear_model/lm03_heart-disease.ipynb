    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"# 阶段 5：特征预处理\\n\",\n",
    "    \"# 处理缺失值、类别特征，并对数值特征进行标准化。\\n\",\n",
    "    \"def norm(input: pd.array) -> pd.array:\\n\",\n",
    "    \"    \\\"\\\"\\\" 最大最小标准化数据 \\\"\\\"\\\"\\n\",\n",
    "    \"    min = input.min()\\n\",\n",
    "    \"    max = input.max()\\n\",\n",
    "    \"    if min == max:\\n\",\n",
    "    \"        return np.zeros_like(input)\\n\",\n",
    "    \"    return (input - min) / (max - min)\\n\",\n",
    "    \"# norm_x = pd.array([1,2,3,4,5])\\n\",\n",
    "    \"# print(norm(norm_x))\\n\",\n",
    "    \"\\n\",\n",
    "    \"X[\\\"age\\\"] = norm(X[\\\"age\\\"])\\n\",\n",
    "    \"X[\\\"trestbps\\\"] = norm(X[\\\"trestbps\\\"])\\n\",\n",
    "    \"X[\\\"chol\\\"] = norm(X[\\\"chol\\\"])\\n\",\n",
    "    \"X[\\\"thalach\\\"] = norm(X[\\\"thalach\\\"])\\n\",\n",
    "    \"print(X[\\\"age\\\"][0:10])\\n\"\n",
    "   ],\n",
