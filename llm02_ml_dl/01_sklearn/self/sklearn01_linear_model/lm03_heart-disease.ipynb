    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"# 阶段 3：定义特征 X 和目标 y\\n\",\n",
    "    \"# X 是患者特征，y 是心脏病标签，通常为 0/1。\\n\",\n",
    "    \"\\n\",\n",
    "    \"target_columns = \\\"target\\\"\\n\",\n",
    "    \"X = data.drop(target_columns, axis=1, inplace=False)\\n\",\n",
    "    \"y = data[target_columns]\\n\",\n",
    "    \"\\n\",\n",
    "    \"# X = X.to_numpy()\\n\",\n",
    "    \"# y = y.to_numpy()\\n\",\n",
